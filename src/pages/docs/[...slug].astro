---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PageModule {
  default: any;
  frontmatter?: {
    title?: string;
    description?: string;
    order?: number;
  };
  getHeadings?: () => Heading[];
}

const mods = import.meta.glob('/src/content/docs/**/*.md', { eager: true }) as Record<string, PageModule>;

function fileToRoute(filePath: string): string {
  const rel = filePath.replace(/^\/src\/content\/docs/, '');
  let route = '/docs' + rel.replace(/\.md$/, '');
  route = route.replace(/\/index$/, '') || '/docs';
  return route.replace(/\/+/g, '/');
}

const pageList = Object.entries(mods).map(([path, mod]) => ({
  file: path,
  route: fileToRoute(path),
  module: mod,
}));

// Generate static paths for every markdown file plus every folder that contains one,
// so directory URLs resolve to an index listing instead of 404ing.
export function getStaticPaths() {
  const modules = import.meta.glob('/src/content/docs/**/*.md', { eager: true }) as Record<string, PageModule>;

  const routes = new Set<string>();

  Object.keys(modules).forEach((filePath) => {
    const rel = filePath.replace(/^\/src\/content\/docs/, '');
    let route = '/docs' + rel.replace(/\.md$/, '');
    route = route.replace(/\/index$/, '') || '/docs';
    route = route.replace(/\/+/g, '/');
    routes.add(route);

    // every ancestor folder of this page
    const parts = route.replace(/^\/docs\/?/, '').split('/').filter(Boolean);
    for (let i = 1; i < parts.length; i++) {
      routes.add('/docs/' + parts.slice(0, i).join('/'));
    }
  });

  routes.add('/docs');

  return Array.from(routes).map((route) => ({
    params: { slug: route.replace(/^\/docs\/?/, '') || undefined },
  }));
}

const { slug } = Astro.params;
const route = '/docs' + (slug ? '/' + slug : '');
const page = pageList.find((p) => p.route === route);

function titleFromKey(key: string): string {
  return key.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

function getTitleFromPath(filePath: string): string {
  const name = filePath.split('/').pop()?.replace('.md', '') || '';
  if (name.toLowerCase() === 'index') {
    const parts = filePath.split('/');
    return parts[parts.length - 2] || 'Home';
  }
  return name.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

// Direct children of this route, used when the route is a folder rather than a page.
interface FolderEntry {
  route: string;
  title: string;
  description?: string;
  isFolder: boolean;
  count: number;
  order: number;
}

const prefix = route === '/docs' ? '/docs/' : route + '/';
const childMap = new Map<string, FolderEntry>();

for (const p of pageList) {
  if (!p.route.startsWith(prefix)) continue;
  const rest = p.route.slice(prefix.length);
  if (!rest) continue;
  const segment = rest.split('/')[0];
  const childRoute = prefix + segment;
  const isFolder = rest.includes('/');

  const existing = childMap.get(childRoute);
  if (existing) {
    existing.count += 1;
    continue;
  }

  childMap.set(childRoute, {
    route: childRoute,
    title: isFolder ? titleFromKey(segment) : p.module.frontmatter?.title || getTitleFromPath(p.file),
    description: isFolder ? undefined : p.module.frontmatter?.description,
    isFolder,
    count: 1,
    order: isFolder ? 999 : p.module.frontmatter?.order ?? 999,
  });
}

const folderEntries = Array.from(childMap.values()).sort((a, b) => {
  if (a.order !== b.order) return a.order - b.order;
  return a.route.localeCompare(b.route, undefined, { numeric: true });
});

const isFolderPage = !page && folderEntries.length > 0;
const folderTitle = slug ? titleFromKey(slug.split('/').pop() || 'Docs') : 'Documentation';
const folderPageCount = pageList.filter((p) => p.route.startsWith(prefix)).length;

const title = page?.module.frontmatter?.title || (isFolderPage ? folderTitle : 'Documentation');
const description =
  page?.module.frontmatter?.description ||
  (isFolderPage ? `${folderPageCount} page${folderPageCount === 1 ? '' : 's'} in this section` : 'Markdown-driven documentation');

// Create slug from title for the main heading
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .trim();
}

// Get headings for table of contents, including the page title
const contentHeadings: Heading[] = page?.module.getHeadings?.() || [];
const titleHeading: Heading = {
  depth: 1,
  slug: slugify(title),
  text: title,
};
const headings: Heading[] = [titleHeading, ...contentHeadings];

// Find prev/next pages for navigation (only meaningful on real pages)
const currentIndex = page ? pageList.findIndex((p) => p.route === route) : -1;
const prevPage = currentIndex > 0 ? pageList[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < pageList.length - 1 ? pageList[currentIndex + 1] : null;
---

<BaseLayout title={title} description={description}>
  {page ? (
    <article class="prose max-w-none">
      <!-- Page Header -->
      <header class="mb-8 pb-8 border-b border-docs-border dark:border-docs-border-dark">
        <h1 id={slugify(title)} class="!mt-0 !mb-3">{title}</h1>
        {page.module.frontmatter?.description && (
          <p class="text-lg text-docs-text-muted dark:text-docs-text-muted-dark !mt-0">
            {page.module.frontmatter.description}
          </p>
        )}
      </header>

      <!-- Main Content -->
      <div class="docs-content">
        <page.module.default />
      </div>

      <!-- Page Navigation -->
      <nav class="mt-16 pt-8 border-t border-docs-border dark:border-docs-border-dark">
        <div class="flex flex-col sm:flex-row justify-between gap-4">
          {prevPage ? (
            <a
              href={prevPage.route}
              class="group flex flex-col p-4 rounded-lg border border-docs-border dark:border-docs-border-dark hover:border-docs-accent dark:hover:border-indigo-400 transition-colors no-underline"
            >
              <span class="text-sm text-docs-text-muted dark:text-docs-text-muted-dark mb-1">Previous</span>
              <span class="font-medium text-docs-text dark:text-docs-text-dark group-hover:text-docs-accent dark:group-hover:text-indigo-400 transition-colors">
                {prevPage.module.frontmatter?.title || getTitleFromPath(prevPage.file)}
              </span>
            </a>
          ) : <div />}

          {nextPage ? (
            <a
              href={nextPage.route}
              class="group flex flex-col p-4 rounded-lg border border-docs-border dark:border-docs-border-dark hover:border-docs-accent dark:hover:border-indigo-400 transition-colors no-underline text-right sm:ml-auto"
            >
              <span class="text-sm text-docs-text-muted dark:text-docs-text-muted-dark mb-1">Next</span>
              <span class="font-medium text-docs-text dark:text-docs-text-dark group-hover:text-docs-accent dark:group-hover:text-indigo-400 transition-colors">
                {nextPage.module.frontmatter?.title || getTitleFromPath(nextPage.file)}
              </span>
            </a>
          ) : null}
        </div>
      </nav>
    </article>
  ) : isFolderPage ? (
    <article class="prose max-w-none">
      <header class="mb-8 pb-8 border-b border-docs-border dark:border-docs-border-dark">
        <h1 id={slugify(title)} class="!mt-0 !mb-3">{title}</h1>
        <p class="text-lg text-docs-text-muted dark:text-docs-text-muted-dark !mt-0">{description}</p>
      </header>

      <div class="not-prose grid gap-3 sm:grid-cols-2">
        {folderEntries.map((entry) => (
          <a
            href={entry.route}
            class="group flex flex-col p-4 rounded-lg border border-docs-border dark:border-docs-border-dark hover:border-docs-accent dark:hover:border-indigo-400 transition-colors no-underline"
          >
            <span class="flex items-center gap-2 font-medium text-docs-text dark:text-docs-text-dark group-hover:text-docs-accent dark:group-hover:text-indigo-400 transition-colors">
              {entry.isFolder && (
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"
                  />
                </svg>
              )}
              {entry.title}
            </span>
            {entry.description && (
              <span class="mt-1 text-sm text-docs-text-muted dark:text-docs-text-muted-dark line-clamp-2">
                {entry.description}
              </span>
            )}
            {entry.isFolder && (
              <span class="mt-1 text-sm text-docs-text-muted dark:text-docs-text-muted-dark">
                {entry.count} page{entry.count === 1 ? '' : 's'}
              </span>
            )}
          </a>
        ))}
      </div>
    </article>
  ) : (
    <div class="text-center py-16">
      <h1 class="text-4xl font-bold text-docs-text dark:text-docs-text-dark mb-4">404</h1>
      <p class="text-docs-text-muted dark:text-docs-text-muted-dark mb-8">Page not found: {route}</p>
      <a
        href="/docs"
        class="inline-flex items-center px-4 py-2 rounded-lg bg-docs-accent text-white hover:bg-docs-accent-hover transition-colors"
      >
        Back to Documentation
      </a>
    </div>
  )}

  <!-- Table of Contents for right sidebar -->
  <TableOfContents slot="toc" headings={headings} />
</BaseLayout>
